# Calculate mean temperature over larval dispersal pathway
rm(list=ls())
options(warn=1)
library(tidyverse)
library(xlsx)
library(terra)
library(RNetCDF)
library(lubridate)
# load("punti_subst.RData") # creato dopo aver fatto la prima temp - riscrivere il codice
load("punti_subst_all.RData")
rm(punti_subst)
# Costruzione nc_map
# --- Percorso NetCDF
nc_path <- "D:/Temperatura POLCOMS/"
# --- Lista file thetao
nc_files <- list.files(nc_path, pattern = "thetao-\\d{4}-\\d{2}-v1\\.1\\.nc$", full.names = TRUE)
# --- Estrae YYYY-MM dal nome file
file_months <- sub(".*thetao-(\\d{4}-\\d{2})-v1\\.1\\.nc$", "\\1", nc_files)
# --- Named vector: "YYYY-MM" -> filepath
nc_map <- setNames(nc_files, file_months)
# Read polygon layer
pol <- vect("sites/sites.shp")
# Read polygon layer
pol <- vect("code/sites/sites.shp")
# Info on the initial positions
init_pos <- vect("../initial_positions_100_0-50m.shp")
# LETTURA GRIGLIA, UNITA' DI TEMPO e FILLVALUE, e punti NA
# Legge da un file di riferimento

# oRIGINE DEL TEMPO
origin_datetime <- sub("seconds since ", "", tunits)
# --- Parametri griglia regolare (robusti a floating noise)
dlon <- mean(diff(lon_nc))
dlat <- mean(diff(lat_nc))
lon0 <- lon_nc[1]
lat0 <- lat_nc[1]
init_pos
init_pos %>% coords
init_pos %>% coord
init_pos %>% crds
init_pos %>% crds[,1] -> lon_init
init_pos %>% crds[,2] -> lat_init
